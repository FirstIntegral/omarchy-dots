#!/usr/bin/env bash
# Put the pack's pinned wallpaper back after `omarchy theme set` rotates it.
# Also runs from post-boot, so a login still re-pins when GitHub is unreachable
# and dots sync bails before its drift check.
#
# The file named in source.json is resolved by omarchy/wallpaper.sh: the
# installed theme, ~/Projects/starship-theme, the stock theme, then the
# omarchy-wallpapers catalog. No image bytes live in this pack.
#
# A catalog hit still leaves one symlink in ~/.config/omarchy/backgrounds/<slug>/
# and drops the other catalog links, so the picker is the theme's own walls
# plus that one default. A theme-owned photo is already in the picker; this
# script does not add a second link.
#
# Same filename as the live background is left alone. Omarchy stages a copy
# under current/theme; that copy is the same photo.
#
# theme-set passes the snake-cased theme slug as $1. post-boot passes nothing.
# A different theme is left alone.

set -euo pipefail

slug="${1:-}"
ROOT="$HOME/Projects/omarchy-dots"
[ -f "$ROOT/omarchy/wallpaper.sh" ] || exit 0
# shellcheck disable=SC1091
. "$ROOT/omarchy/wallpaper.sh"

want_theme="$(dots_json_get theme)"
name="$(dots_json_get wallpaper)"
[ -n "$want_theme" ] && [ -n "$name" ] || exit 0

want_slug="$(dots_theme_slug "$want_theme")"
if [ -n "$slug" ] && [ "$slug" != "$want_slug" ]; then
  exit 0
fi

file="$(dots_resolve_wallpaper "$name" "$want_slug" || true)"
[ -n "$file" ] || exit 0

if dots_wallpaper_in_catalog "$file"; then
  catalog="$HOME/Projects/omarchy-wallpapers/backgrounds"
  dest="$HOME/.config/omarchy/backgrounds/$want_slug"
  mkdir -p "$dest"
  shopt -s nullglob
  for link in "$dest"/*; do
    [ -L "$link" ] || continue
    target="$(readlink "$link" || true)"
    case "$target" in
      "$catalog"/*)
        [ "$(basename "$link")" = "$name" ] && continue
        rm -f -- "$link"
        ;;
    esac
  done
  ln -sfn "$file" "$dest/$name"
fi

dots_wallpaper_current "$name" && exit 0

exec omarchy theme bg set "$file"
